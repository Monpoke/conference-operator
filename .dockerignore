# Everything that has no business in the hub's build context.
# The rule: only the monorepo's sources are sent — the hub runs in TypeScript
# through tsx, there is no build output to preserve.

.git
.github
node_modules
**/node_modules
dist
**/dist
out
**/out
release
**/release
.turbo
**/.turbo
*.tsbuildinfo

# Runtime data: a dev database copied into the image would be worse than useless.
# `.out` is OBS's recording folder in development — several hundred megabytes of
# raw footage, which `out` (without the dot) does not filter.
data
**/data
.out
**/.out
*.db
*.db-wal
*.db-shm
.local-data
**/.local-data

# Secrets: never in an image.
.env
.env.*
!.env.example

# Regenerated HTML previews, graft cache, agent tooling.
**/preview/
graft
.claude
.mcp.json
.ignore

# The room client is not installed (pnpm filter) but its manifest is — see the
# Dockerfile. The rest is of no use here.
apps/room-client/src
apps/room-client/test
apps/room-client/scripts
apps/room-client/build

# Local sandboxes: out of the repository since they were gitignored, but present
# on the machine that ran them — and the build context would send them.
spikes
