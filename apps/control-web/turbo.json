{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    /*
     * The same call as for the console: the bundle is an artefact.
     *
     * `room-client` does not depend on this task — it looks for a folder when it
     * serves, it imports nothing from here. That is what keeps `pnpm test` clear
     * of any Vite build. The build happens where it is useful: in the Electron
     * packaging, which embeds the result.
     */
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
