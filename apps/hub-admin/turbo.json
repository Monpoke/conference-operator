{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    /*
     * Le bundle est un artefact, pas une source.
     *
     * `hub-server` ne dépend pas de cette tâche : il lit un dossier au moment
     * de servir, il n'importe rien de la console. C'est ce qui permet à
     * `pnpm typecheck` et `pnpm test` de ne déclencher aucun build Vite — et
     * à la suite de tenir dans la minute que la CI revendique. Le build a lieu
     * là où il sert : dans l'étape « Console » du Dockerfile.
     */
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
