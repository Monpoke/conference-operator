# Mode d'exécution : production (défaut) ou dev.
# Un seul interrupteur devant les commodités de développement : SIMULATED_TIME
# ci-dessous, et le réglage de l'heure depuis la console. En production elles
# sont IGNORÉES même si elles sont renseignées, et le hub le dit au démarrage
# et dans la console. Il démarre quand même : refuser de repartir en cours
# d'événement serait pire que le mal.
MODE=production

# Secret de signature Better Auth — générer avec `openssl rand -base64 48`
BETTER_AUTH_SECRET=

# Base publique du hub (utilisée par Better Auth et l'URI de vérification device)
PUBLIC_URL=http://localhost:8787
PORT=8787
HOST=0.0.0.0

DATABASE_PATH=./data/hub.db
LOG_LEVEL=info

# Cadence de polling imposée aux machines pendant l'appairage (RFC 8628)
DEVICE_POLL_INTERVAL=5s

# Durée de vie d'un code d'appairage, et de la demande qui l'accompagne dans la
# console. Dix minutes : assez court pour que la file de la console se vide
# seule plutôt que d'accumuler des codes morts, assez long pour traverser une
# salle entre l'écran qui affiche le code et la console qui l'approuve.
# Rien n'est perdu s'il expire : la machine en redemande un sous 15 s, et la
# console dit « Code expiré » plutôt que de laisser approuver dans le vide.
DEVICE_CODE_TTL=10m

# Connexion des opérateurs par Google Workspace. Les deux identifiants viennent
# du client OAuth « Application Web » de la console Google Cloud, dont l'URI de
# redirection autorisée doit être <PUBLIC_URL>/api/auth/callback/google.
# Laissées vides, la console ne propose que le mot de passe.
# TOUT COMPTE DU DOMAINE CI-DESSOUS EST UN OPÉRATEUR : c'est l'annuaire qui fait
# la liste. Le domaine est envoyé à Google ET revérifié contre la revendication
# du jeton d'identité au retour.
# Sans défaut, et OBLIGATOIRE dès que GOOGLE_CLIENT_ID est renseigné : le hub
# refuse de démarrer plutôt que de deviner qui a le droit d'entrer.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_HOSTED_DOMAIN=votre-domaine.fr

# Notifications poussées aux consoles, même fenêtre fermée (Web Push, RFC 8292).
# Facultatives : sans elles, le hub fabrique une paire au premier démarrage et
# la garde en base. Les renseigner sert à survivre à une base recréée — des clés
# qui changent invalident tous les abonnements, et personne ne se réabonne deux
# fois. Générer avec : npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# Contact que la RFC impose d'annoncer aux services de push, qui écriront là en
# cas d'abus. Absent, le hub le dérive de son propre domaine
# (mailto:hub@<domaine de PUBLIC_URL>) : syntaxiquement valide, mais rien ne
# garantit que quelqu'un relève cette boîte. À RENSEIGNER EN PRODUCTION.
# VAPID_SUBJECT=mailto:contact@votre-domaine.fr

# Stockage S3 des rushes. LES TROIS VONT ENSEMBLE.
#
# Facultatif : sans eux, le rapatriement des rushes n'existe pas — pas d'onglet
# actif dans la console, pas de boucle de ménage, et les salles gardent leurs
# fichiers. C'est le cas normal d'un hub qui n'en a pas besoin.
#
# Renseignés à moitié, en revanche, LE HUB REFUSE DE DÉMARRER : deux variables
# sur trois monteraient une console qui annonce un stockage prêt et des
# téléversements qui échouent tous à la signature — on chercherait alors la
# panne dans les droits du bucket, pas dans un .env amputé d'une ligne.
#
# Une clé d'accès n'a rien à faire dans une base qu'on sauvegarde ni dans une
# console qu'on ouvre depuis un téléphone. Les salles, elles, ne reçoivent
# JAMAIS ces clés : le hub signe des adresses à durée de vie courte, et c'est
# tout ce qui descend en salle.
# S3_ENDPOINT=https://s3.gra.io.cloud.ovh.net
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# Bucket où atterrissent les rushes — AMORCE SEULEMENT.
# Ensuite c'est le réglage de la console (onglet VOD) qui fait foi : un bucket
# corrigé en cours d'événement doit survivre au redémarrage qui suit, et cette
# ligne le réécraserait à chaque fois. Même règle que PROGRAM_SOURCE_URL.
# Elle existe pour les déploiements où personne n'ouvre la console — machine
# provisionnée d'avance, script qui monte le hub : sans elle, un hub fraîchement
# déployé démarre avec ses clés et aucune destination.
# À SAVOIR : vider le champ dans la console n'éteint donc pas durablement le
# rapatriement, puisque le démarrage suivant le réamorcerait. Pour l'éteindre,
# décocher « Téléverser automatiquement » — ce réglage-là, rien ne le réécrit.
# Le préfixe, lui, n'a pas d'équivalent ici : il se règle dans la console.
# S3_BUCKET=rushes-cloudnord

# Autorité de certification du stockage, pour un S3 interne.
# Chemin vers un fichier PEM — celui de la CA, pas celui du serveur ; plusieurs
# CA se concatènent dans un seul fichier.
# Node n'utilise PAS le magasin de certificats du système : il embarque sa
# propre liste de CA publiques. Un stockage signé par une CA d'entreprise échoue
# donc sur UNABLE_TO_GET_ISSUER_CERT_LOCALLY, message qui ne dit ni ce qui
# manque ni où le poser.
# Le hub s'en sert pour ses propres appels ET LA DESCEND AUX SALLES au sync :
# rien à poser sur les machines de salle, et la corriger ne demande pas de
# retourner devant trois postes Electron un matin d'événement. Un certificat
# d'autorité est public par construction — le diffuser n'est pas diffuser un
# secret. Il ne vaut que pour le stockage : rien d'autre n'en change.
# Illisible, le hub le dit en erreur au démarrage et continue sans : le
# rapatriement échouera, le reste de la journée non.
# S3_CA_CERT=/etc/ssl/certs/ca-interne.pem

# Région signée. Rarement à changer : la plupart des stockages compatibles
# l'ignorent, mais elle entre dans la signature et doit correspondre à ce
# qu'attend le fournisseur.
# S3_REGION=us-east-1
# Adressage « endpoint/bucket/clé » plutôt que « bucket.endpoint/clé ». Vrai par
# défaut : c'est ce que veulent MinIO et la plupart des compatibles, et le seul
# mode qui marche sur une adresse IP. AWS lui-même n'accepte plus que l'autre.
# S3_FORCE_PATH_STYLE=true
# Minutes de silence après lesquelles un téléversement est abandonné et son
# multipart fermé chez le stockage. Une salle éteinte en pleine montée ne dit
# rien : sans cette échéance, son multipart resterait ouvert — et facturé —
# indéfiniment. Assez long pour qu'une coupure de quelques minutes ne fasse pas
# tout recommencer. Poser en plus une règle de cycle de vie sur le bucket : le
# ménage du hub couvre le hub qui tourne, la règle couvre le hub qui ne tourne
# plus.
# VOD_ABANDON_MINUTES=30

# Export « conference-center » — amorce du tout premier démarrage.
# Ensuite, c'est le réglage « Source du programme » de la console qui fait foi :
# une URL corrigée en cours d'événement doit survivre au redémarrage qui suit,
# et cette ligne la réécraserait à chaque fois. Laissée telle quelle, elle ne
# sert plus qu'à amorcer une base vide.
# C'EST AUSSI CE QUI NOMME L'ÉVÉNEMENT : le hub lit `event.name` du programme
# importé et en titre le mur public, la console, les notifications et les
# écrans de salle. Servir un autre événement ne demande rien de plus que de
# pointer ici son export. Le nom ne se règle à la main — dans Réglages →
# L'événement — que pour contredire un export qui porte un nom interne.
PROGRAM_SOURCE_URL=https://storage.googleapis.com/conferencecenterr.appspot.com/events/TFPEvIEBweOiOwYBI5sM/0cb64941-9857-4d6b-99e7-75fb4d855ca4.json

# Heure simulée du hub. Nécessite MODE=dev.
# Déplace tout le système : les salles s'alignent sur l'heure du hub, il n'y a
# rien à régler de leur côté. Permet de dérouler la journée de l'événement dès
# maintenant — la console propose des raccourcis vers ses moments clés, déduits
# du programme importé. Laisser vide en production.
# SIMULATED_TIME=2026-10-30T10:20:00.000Z

# CLOCK_CONTROL n'existe plus : le réglage de l'heure depuis la console suit
# MODE. Ouvert en dev, fermé en production — changer l'heure pendant l'événement
# fausserait les timecodes des enregistrements et déclencherait des clôtures
# automatiques à contretemps. Le laisser ici ne fait rien, et le hub le dira.
