# Secret de signature Better Auth — générer avec `openssl rand -base64 48`
BETTER_AUTH_SECRET=

# Base publique du hub (utilisée par Better Auth et l'URI de vérification device)
PUBLIC_URL=http://localhost:8787
PORT=8787
HOST=0.0.0.0

DATABASE_PATH=./data/hub.db
LOG_LEVEL=info

# Cadence de polling imposée aux machines pendant l'appairage (RFC 8628)
DEVICE_POLL_INTERVAL=5s

# Export « conference-center » importé au premier démarrage
PROGRAM_SOURCE_URL=https://storage.googleapis.com/conferencecenterr.appspot.com/events/TFPEvIEBweOiOwYBI5sM/0cb64941-9857-4d6b-99e7-75fb4d855ca4.json

# Heure simulée du hub (développement uniquement).
# Déplace tout le système : les salles s'alignent sur l'heure du hub, il n'y a
# rien à régler de leur côté. Permet de dérouler la journée du 30 octobre dès
# maintenant. Laisser vide en production.
# SIMULATED_TIME=2026-10-30T10:20:00.000Z

# Autorise le réglage de l'heure depuis la console (onglet Réglages).
# Fermé par défaut : changer l'heure pendant l'événement fausserait les timecodes
# des enregistrements et déclencherait des clôtures automatiques à contretemps.
# CLOCK_CONTROL=1
