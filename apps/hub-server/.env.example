# Mode d'exécution : production (défaut) ou dev.
# Un seul interrupteur devant les commodités de développement : SIMULATED_TIME
# ci-dessous, et le réglage de l'heure depuis la console. En production elles
# sont IGNORÉES même si elles sont renseignées, et le hub le dit au démarrage
# et dans la console. Il démarre quand même : refuser de repartir en cours
# d'événement serait pire que le mal.
MODE=production

# Secret de signature Better Auth — générer avec `openssl rand -base64 48`
BETTER_AUTH_SECRET=

# Base publique du hub (utilisée par Better Auth et l'URI de vérification device)
PUBLIC_URL=http://localhost:8787
PORT=8787
HOST=0.0.0.0

DATABASE_PATH=./data/hub.db
LOG_LEVEL=info

# Cadence de polling imposée aux machines pendant l'appairage (RFC 8628)
DEVICE_POLL_INTERVAL=5s

# Export « conference-center » — amorce du tout premier démarrage.
# Ensuite, c'est le réglage « Source du programme » de la console qui fait foi :
# une URL corrigée en cours d'événement doit survivre au redémarrage qui suit,
# et cette ligne la réécraserait à chaque fois. Laissée telle quelle, elle ne
# sert plus qu'à amorcer une base vide.
PROGRAM_SOURCE_URL=https://storage.googleapis.com/conferencecenterr.appspot.com/events/TFPEvIEBweOiOwYBI5sM/0cb64941-9857-4d6b-99e7-75fb4d855ca4.json

# Heure simulée du hub. Nécessite MODE=dev.
# Déplace tout le système : les salles s'alignent sur l'heure du hub, il n'y a
# rien à régler de leur côté. Permet de dérouler la journée du 30 octobre dès
# maintenant. Laisser vide en production.
# SIMULATED_TIME=2026-10-30T10:20:00.000Z

# CLOCK_CONTROL n'existe plus : le réglage de l'heure depuis la console suit
# MODE. Ouvert en dev, fermé en production — changer l'heure pendant l'événement
# fausserait les timecodes des enregistrements et déclencherait des clôtures
# automatiques à contretemps. Le laisser ici ne fait rien, et le hub le dira.
