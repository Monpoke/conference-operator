{
  "name": "@cloudnord/hub-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env --import tsx src/main.ts",
    "start": "tsx --env-file-if-exists=.env src/main.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "operator": "tsx --env-file-if-exists=.env src/cli/operator.ts",
    "preview": "tsx scripts/preview-console.ts"
  },
  "dependencies": {
    "@better-auth/core": "1.7.1",
    "@cloudnord/contract": "workspace:*",
    "@cloudnord/db": "workspace:*",
    "@cloudnord/room-state": "workspace:*",
    "@cloudnord/format": "workspace:*",
    "@cloudnord/program": "workspace:*",
    "@cloudnord/ui": "workspace:*",
    "@fastify/http-proxy": "11.3.0",
    "@fastify/static": "8.2.0",
    "@orpc/server": "2.0.0-beta.29",
    "better-auth": "1.7.1",
    "better-sqlite3": "13.0.3",
    "drizzle-orm": "0.45.2",
    "fastify": "5.12.1",
    "tsx": "4.23.12",
    "ulid": "3.0.2",
    "web-push": "3.6.7",
    "ws": "8.19.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@cloudnord/hub-admin": "workspace:*",
    "@cloudnord/hub-client": "workspace:*",
    "@orpc/client": "2.0.0-beta.29",
    "@orpc/contract": "2.0.0-beta.29",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "26.2.0",
    "@types/web-push": "3.6.4",
    "@types/ws": "8.18.1",
    "happy-dom": "20.11.6",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  },
  "exports": {
    "./server": "./src/server.ts",
    "./operators": "./src/operators.ts",
    "./config": "./src/config.ts"
  }
}
