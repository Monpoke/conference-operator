{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    /*
     * The hub's tests need the console's bundle.
     *
     * The hub does not import it — it reads a folder when it serves — but what is
     * verified here is precisely that it serves it. Letting the test depend on a
     * `dist/` that happens to be present would give a suite that passes or fails
     * according to what is lying around on the machine: that was the case, and it
     * only showed up in continuous integration.
     *
     * The cost is a three-second `vite build`, cached by turbo for as long as the
     * console does not change.
     */
    "test": {
      "dependsOn": ["^build"]
    }
  }
}
