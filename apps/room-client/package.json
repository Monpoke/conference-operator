{
  "name": "@cloudnord/room-client",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "preview": "tsx scripts/preview-display.ts",
    "build": "node scripts/build-main.mjs",
    "package:win": "pnpm --filter @cloudnord/regie-web build && pnpm build && electron-builder --win --publish never",
    "package:dir": "pnpm --filter @cloudnord/regie-web build && pnpm build && electron-builder --dir --publish never",
    "dev": "node scripts/build-main.mjs && electron dist/main.cjs",
    "dev:headless": "tsx scripts/dev-headless.ts"
  },
  "dependencies": {
    "@cloudnord/contract": "workspace:*",
    "@cloudnord/db": "workspace:*",
    "@cloudnord/etat-salle": "workspace:*",
    "@cloudnord/format": "workspace:*",
    "@cloudnord/program": "workspace:*",
    "@cloudnord/ui": "workspace:*",
    "@fastify/http-proxy": "11.3.0",
    "@fastify/static": "8.2.0",
    "@orpc/client": "2.0.0-beta.29",
    "@orpc/contract": "2.0.0-beta.29",
    "@orpc/server": "2.0.0-beta.29",
    "better-sqlite3": "13.0.3",
    "drizzle-orm": "0.45.2",
    "fastify": "5.12.1",
    "obs-websocket-js": "5.0.8",
    "qrcode": "1.5.4",
    "ulid": "3.0.2",
    "ws": "8.19.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@cloudnord/hub-server": "workspace:*",
    "@cloudnord/regie-web": "workspace:*",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "26.2.0",
    "@types/qrcode": "1.5.6",
    "@types/ws": "8.18.1",
    "electron": "43.4.1",
    "electron-builder": "26.0.12",
    "esbuild": "0.28.2",
    "happy-dom": "20.11.6",
    "tsx": "4.23.12",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  },
  "main": "dist/main.cjs"
}
