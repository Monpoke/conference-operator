{
  "name": "@conference-operator/room-client",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "preview": "tsx scripts/preview-display.ts",
    "build": "node scripts/build-main.mjs",
    "package:win": "pnpm --filter @conference-operator/control-web build && pnpm build && electron-builder --win --publish never",
    "package:dir": "pnpm --filter @conference-operator/control-web build && pnpm build && electron-builder --dir --publish never",
    "dev": "node scripts/build-main.mjs && electron dist/main.cjs",
    "dev:headless": "tsx scripts/dev-headless.ts"
  },
  "dependencies": {
    "@conference-operator/contract": "workspace:*",
    "@conference-operator/db": "workspace:*",
    "@conference-operator/format": "workspace:*",
    "@conference-operator/program": "workspace:*",
    "@conference-operator/room-state": "workspace:*",
    "@conference-operator/ui": "workspace:*",
    "@fastify/http-proxy": "11.6.2",
    "@fastify/static": "10.1.3",
    "@orpc/client": "2.0.0-beta.29",
    "@orpc/contract": "2.0.0-beta.29",
    "@orpc/server": "2.0.0-beta.29",
    "better-sqlite3": "13.0.3",
    "drizzle-orm": "0.45.2",
    "fastify": "5.12.3",
    "obs-websocket-js": "5.0.8",
    "qrcode": "1.5.4",
    "ulid": "3.0.2",
    "ws": "8.21.3",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@conference-operator/control-web": "workspace:*",
    "@conference-operator/hub-server": "workspace:*",
    "@types/better-sqlite3": "9.6.0",
    "@types/js-yaml": "4.0.9",
    "@types/node": "26.4.1",
    "@types/qrcode": "1.5.6",
    "@types/ws": "8.18.1",
    "electron": "44.2.0",
    "electron-builder": "26.15.3",
    "electron-builder-squirrel-windows": "26.15.3",
    "esbuild": "0.28.2",
    "happy-dom": "20.14.0",
    "js-yaml": "5.4.1",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vitest": "5.0.0"
  },
  "main": "dist/main.cjs"
}
