{
  "name": "cloudnord-roomdisplay",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:duo": "bash scripts/dev-rooms.sh 1",
    "dev:trio": "bash scripts/dev-rooms.sh 2",
    "prepare": "node scripts/git-hooks.mjs",
    "reset:dev": "bash scripts/reset-dev.sh",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@types/node": "26.2.0",
    "tsx": "4.23.12",
    "turbo": "2.10.11",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
