{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    /*
     * La feuille est compilée à partir des pages des applications.
     *
     * Sans ces entrées, le cache de turbo ne voit que ce paquet : une classe
     * ajoutée dans une page du hub laissait la compilation en cache, la feuille
     * committée périmée, et le test qui devait le dire ne se rejouait même pas.
     * La classe n'avait alors aucun style — exactement la panne silencieuse
     * contre laquelle ce test existe. Les chemins suivent les `@source` de
     * `src/theme.css` : les changer ici sans les changer là ne servirait à rien.
     *
     * Ils ne suivent **pas** ceux de `src/apps.css`, et c'est voulu : cette
     * feuille-là est compilée par Vite, à la demande de chaque application Vue,
     * et ne passe jamais par `src/generated/`. Y ajouter les répertoires de
     * composants ferait recompiler la feuille figée — et la ferait grossir de
     * tous les utilitaires des applications — à chaque retouche d'un `.vue`.
     */
    "build": {
      "inputs": [
        "src/**",
        "scripts/**",
        "package.json",
        "$TURBO_ROOT$/apps/hub-server/src/pages/**",
        "$TURBO_ROOT$/apps/room-client/src/core/**"
      ]
    },
    "test": {
      "inputs": [
        "src/**",
        "scripts/**",
        "test/**",
        "package.json",
        "$TURBO_ROOT$/apps/hub-server/src/pages/**",
        "$TURBO_ROOT$/apps/room-client/src/core/**"
      ]
    }
  }
}
