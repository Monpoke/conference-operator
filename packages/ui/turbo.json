{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    /*
     * The sheet is compiled from the applications' pages.
     *
     * Without these inputs, turbo's cache only sees this package: a class added to
     * one of the hub's pages left the compilation cached, the committed sheet
     * stale, and the test that was meant to say so did not even replay. The class
     * then had no style at all — exactly the silent breakage this test exists
     * against. The paths follow `src/theme.css`'s `@source` entries: changing them
     * here without changing them there would achieve nothing.
     *
     * They do **not** follow `src/apps.css`'s, and that is deliberate: that sheet
     * is compiled by Vite, on demand for each Vue application, and never goes
     * through `src/generated/`. Adding the component directories to it would
     * recompile the frozen sheet — and grow it by all the applications' utilities
     * — on every tweak to a `.vue`.
     */
    "build": {
      "inputs": [
        "src/**",
        "scripts/**",
        "package.json",
        "$TURBO_ROOT$/apps/hub-server/src/pages/**",
        "$TURBO_ROOT$/apps/room-client/src/core/**"
      ]
    },
    "test": {
      "inputs": [
        "src/**",
        "scripts/**",
        "test/**",
        "package.json",
        "$TURBO_ROOT$/apps/hub-server/src/pages/**",
        "$TURBO_ROOT$/apps/room-client/src/core/**"
      ]
    }
  }
}
