{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**",
        "out/**",
        ".vite/**",
        "src/generated/**"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^build"
      ]
    },
    "test": {
      "dependsOn": [
        "^build"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      /*
       * Turbo 2 filters the tasks' environment ("strict" mode).
       * Without this list, `MODE=dev pnpm dev` at the root would start both
       * applications in production, without a word — exactly the silence the mode
       * exists to avoid. `OBS_MOCK` is listed too: the guard has to see it in
       * order to be able to say it is ignoring it.
       */
      "passThroughEnv": [
        "MODE",
        "HUB_ORIGIN",
        "PORT",
        "HOST",
        "DATABASE_PATH",
        "VITE_ORIGIN",
        "REGIE_VITE_ORIGIN",
        "S3_ENDPOINT",
        "S3_REGION",
        "S3_BUCKET",
        "S3_CA_CERT",
        "S3_ACCESS_KEY_ID",
        "S3_SECRET_ACCESS_KEY",
        "S3_FORCE_PATH_STYLE",
        "VOD_ABANDON_MINUTES",
        "SIMULATED_TIME",
        "CLOCK_CONTROL",
        "HEURE_SIMULEE",
        "OBS_MOCK",
        "OBS_REEL",
        "ROOM_ID",
        "DISPLAY_PORT",
        "DATA_DIR"
      ]
    }
  }
}
